# Copy to deploy/.env and change before exposing to a network.
POSTGRES_DB=core
POSTGRES_USER=core
POSTGRES_PASSWORD=change-me
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me
DATABASE_URL=postgresql://core:change-me@db:5432/core
S3_ENDPOINT=http://minio:9000
S3_BUCKET=rock-core
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change-me
S3_REGION=us-east-1
